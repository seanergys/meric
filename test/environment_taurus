#!/bin/bash 
# version TAURUS

# bash script to load modules and set environment varibles to run MERIC test
# parametres:
#	-t = optional, doesn't change environment only prints list of MERIC variables, that are set

###############################################################################
# MACHINE DEPENDET SECTION

 ### MODULES ### TAURUS ###
modules() 
{
        module purge
        module load intel/2016.1.150
        module load mpirt/5.1.2.150
        module load hdeem/2.2.2
        module load papi/5.4.1
}

###############################################################################
# FUNCTIONS

 ### PRINT LIST OF ENV VARIABLES ###
variables()
{
	for exp in MERIC_FREQUENCY MERIC_UNCORE_FREQUENCY MERIC_NUM_THREADS MERIC_COUNTERS MERIC_CONTINUAL MERIC_DETAILED MERIC_AGGREGATE MERIC_DEBUG MERIC_MODE
	do
        	if [ ! -z ${!exp} ]
	        then
                	echo $exp "=" ${!exp}
        	fi
	done
}

###############################################################################

# test if script is in interactive mode
if [[ $- != *i* ]]
then
	echo "WARNING: source this script to set environment. Test only."
	echo
	variables
	exit 1
fi

# test options only
if [[ $1 == "-t" ]]
then
	variables
	return 0
fi

# load modules
modules

 ### ENVIRONMENT VARIABLES ###
export MERIC_FREQUENCY=25
export MERIC_UNCORE_FREQUENCY=25 
#export MERIC_NUM_THREADS=24 
#export MERIC_COUNTERS=perfevent	#perfevent papi
export MERIC_MODE=1	#enum {hdeem, rapl, both, run}
# export MERIC_AGGREGATE=1
# export MERIC_CONTINUAL=0
# export MERIC_DETAILED=0
# export MERIC_DEBUG=1

echo
variables



